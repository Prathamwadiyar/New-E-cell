# JCER E-CELL — Supabase frontend configuration (example)
# Copy this file to .env.local and replace the placeholders with your project
# values. .env.local is git-ignored and must never be committed.
#
# These are PUBLIC values (safe in the browser). RLS enforces authorization.
# NEVER put the Supabase service-role key or any secret in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
